# BehavioralTrust Frontend Configuration (Affecio Hacks '26)

# Real backend base URL (used when VITE_USE_MOCK is false)
VITE_API_URL=http://localhost:8000

# Set to "true" to run against the in-memory mock server, or "false" to connect to real FastAPI backend
VITE_USE_MOCK=true

# Set to "true" to reveal stage dev tools ("Try upload anyway" bypass button and raw WebSocket debug strip)
VITE_SHOW_DEV_TOOLS=false
